# Solana
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# IPFS (NFT.Storage)
NEXT_PUBLIC_NFT_STORAGE_API_KEY=your_key

# Program IDs (after `anchor deploy`)
NEXT_PUBLIC_MARKETPLACE_PROGRAM_ID=MKT1111111111111111111111111111111111111111
NEXT_PUBLIC_REWARDS_PROGRAM_ID=RWD1111111111111111111111111111111111111111
NEXT_PUBLIC_CASHBACK_PROGRAM_ID=CSH1111111111111111111111111111111111111111
NEXT_PUBLIC_ESCROW_PROGRAM_ID=ESC1111111111111111111111111111111111111111
