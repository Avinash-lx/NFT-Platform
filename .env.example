# ─── Solana ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# ─── IPFS ───────────────────────────────────────────────────────────────
NFT_STORAGE_API_KEY=your_key

# ─── Backend ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://prism:prism@localhost:5432/prism
REDIS_URL=redis://localhost:6379
TREASURY_WALLET_PRIVATE_KEY=
MARKETPLACE_FEE_BPS=250        # 2.5%
CASHBACK_PERCENT=5

# ─── Programs (after `anchor deploy`) ───────────────────────────────────
NEXT_PUBLIC_MARKETPLACE_PROGRAM_ID=
NEXT_PUBLIC_REWARDS_PROGRAM_ID=
NEXT_PUBLIC_CASHBACK_PROGRAM_ID=
NEXT_PUBLIC_ESCROW_PROGRAM_ID=
